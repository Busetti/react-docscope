{
  "name": "react-docscope-monorepo",
  "private": true,
  "description": "Monorepo for react-docscope \u2014 a universal, read-only React document preview library.",
  "license": "MIT",
  "author": "Gurunath Busetti",
  "type": "module",
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "pnpm --filter react-docscope build",
    "build:all": "pnpm -r build",
    "dev": "pnpm --filter react-docscope build && pnpm --parallel --filter react-docscope --filter playground dev",
    "playground": "pnpm --filter playground dev",
    "storybook": "pnpm --filter docs storybook",
    "build:pages": "node scripts/build-pages.mjs",
    "fixtures": "node scripts/generate-large-fixtures.mjs",
    "test": "jest",
    "test:coverage": "jest --coverage && node scripts/check-coverage.mjs",
    "test:watch": "jest --watch",
    "test:react18": "REACT_VERSION=18 jest",
    "test:e2e": "pnpm fixtures && pnpm build && pnpm --filter playground build && playwright test",
    "test:visual": "pnpm fixtures && pnpm build && pnpm --filter playground build && playwright test --project=visual",
    "test:smoke": "node scripts/smoke-test.mjs",
    "perf": "node tests/performance/bundle-size.mjs",
    "perf:render": "playwright test --project=performance",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --filter react-docscope --filter playground --filter docs typecheck",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@swc/core": "^1.16.21",
    "@swc/jest": "^0.2.39",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/jest": "^30.0.0",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fflate": "^0.8.3",
    "globals": "^17.0.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.5.2",
    "jest-axe": "^11.0.0",
    "jest-environment-jsdom": "^30.5.2",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-18": "npm:react@18.3.1",
    "react-dom": "^19.3.1",
    "react-dom-18": "npm:react-dom@18.3.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
