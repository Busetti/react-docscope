{
  "name": "react-docscope",
  "version": "0.1.0",
  "description": "Universal, read-only React document preview: PDF, images, DOCX, PPTX, XLSX, CSV, Markdown, TXT, JSON, XML and video — with search, zoom, attachments navigation and split-screen comparison.",
  "license": "MIT",
  "author": "Gurunath Busetti",
  "homepage": "https://github.com/Busetti/react-docscope#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Busetti/react-docscope.git",
    "directory": "packages/react-docscope"
  },
  "bugs": {
    "url": "https://github.com/Busetti/react-docscope/issues"
  },
  "keywords": [
    "react",
    "document-viewer",
    "file-preview",
    "pdf-viewer",
    "docx",
    "pptx",
    "xlsx",
    "csv",
    "markdown",
    "attachments",
    "compare"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "dev": "vite build --watch --mode development",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "node ../../scripts/copy-package-docs.mjs"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-virtual": "^3.14.24",
    "docx-preview": "^0.4.1",
    "fflate": "^0.8.3",
    "lucide-react": "^1.66.0",
    "papaparse": "^5.7.0",
    "pdfjs-dist": "^6.4.299",
    "pptxtojson": "~2.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.5"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
